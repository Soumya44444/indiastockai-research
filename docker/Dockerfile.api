# Dockerfile for the FastAPI backend (project spec Section 25)
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (needed for psycopg2 and some ML libs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first (better layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

# Copy application code
COPY app/ ./app/

# NOTE: Render (and most PaaS platforms) assign a dynamic port via the
# PORT env var and expect the app to bind to it — hardcoding 8000 caused
# Render's port-detection to fail ("No open ports detected"). Defaulting
# to 8000 locally (docker-compose sets no PORT, so it falls back to 8000,
# matching the "8000:8000" port mapping already in docker-compose.yml).
EXPOSE 8000

CMD uvicorn app.api.main:app --host 0.0.0.0 --port ${PORT:-8000}